{
	frankenphp
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root /app/public
	encode zstd br gzip

	# Vite output is content-hashed, everything else stays revalidated.
	@immutable path /build/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	php_server

	log {
		output stdout
		format console
	}
}
